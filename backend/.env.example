# Runtime configuration. All durations are milliseconds.
NODE_ENV="development"
HOST="127.0.0.1"
PORT="3000"
LOG_LEVEL="info"
REQUEST_TIMEOUT_MS="10000"
HANDLER_TIMEOUT_MS="15000"
KEEP_ALIVE_TIMEOUT_MS="5000"
SHUTDOWN_GRACE_PERIOD_MS="10000"

# Clerk authentication (server-side unless explicitly described otherwise)
CLERK_PUBLISHABLE_KEY="replace_with_environment_specific_publishable_key"
CLERK_SECRET_KEY="replace_with_environment_specific_server_secret"
# Alternatively, use a Clerk JWT verification key if the approved auth design selects it.
# CLERK_JWT_KEY="replace_with_environment_specific_jwt_verification_key"

# PostgreSQL connection string for this environment only.
DATABASE_URL="replace_with_environment_specific_postgresql_connection_url"

# Local placeholder only. Production and staging values must come from their approved
# versioned secret/key stores and must never be committed.
CREDENTIAL_ENCRYPTION_KEY="replace_with_local_development_key_material"
# Use local-vN in development and production-vN in production.
CREDENTIAL_ENCRYPTION_KEY_VERSION="local-v1"
OAUTH_STATE_HMAC_KEY="replace_with_a_separate_32_byte_base64_key"

# Google OAuth credentials dedicated to this environment.
GOOGLE_OAUTH_CLIENT_ID="replace_with_environment_specific_client_id"
GOOGLE_OAUTH_CLIENT_SECRET="replace_with_environment_specific_client_secret"
GOOGLE_OAUTH_REDIRECT_URI="https://api.narial.in/api/v1/youtube/oauth/callback"

# Comma-separated exact allowlists. Wildcards are forbidden.
ALLOWED_APP_RETURN_URLS="narrial://youtube/connection-return,http://localhost:8081/youtube/connection-return"
ALLOWED_WEB_ORIGINS="http://localhost:8081"
